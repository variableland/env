{
  "name": "docsite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#collections/*": "./.source/*"
  },
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "check:seo": "pnpm dlx start-server-and-test@3.0.5 \"vite preview --host 127.0.0.1 --port 4173 --strictPort\" http://127.0.0.1:4173 \"pnpm dlx unlighthouse@0.17.9 --site http://127.0.0.1:4173\"",
    "check:seo-ci": "vite build && pnpm dlx start-server-and-test@3.0.5 \"vite preview --host 127.0.0.1 --port 4173 --strictPort\" http://127.0.0.1:4173 \"pnpm dlx -p unlighthouse@0.17.9 unlighthouse-ci --site http://127.0.0.1:4173\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-start": "1.167.65",
    "fumadocs-core": "16.8.10",
    "fumadocs-mdx": "15.0.4",
    "fumadocs-ui": "16.8.10",
    "lucide-react": "1.14.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.4",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/router-plugin": "1.167.35",
    "@types/mdx": "2.0.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "4.3.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "^4.90.1"
  }
}
